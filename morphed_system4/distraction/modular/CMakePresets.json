{
    "version": 3,
    "configurePresets": [
        {
            "name": "gcc-win-release",
            "displayName": "GCC Windows Release",
            "description": "Local Windows build via MSYS2 UCRT64",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
            }
        },
        {
            "name": "gcc-win-debug",
            "displayName": "GCC Windows Debug",
            "description": "Local Windows development via MSYS2 UCRT64",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-win-release",
            "configurePreset": "gcc-win-release"
        },
        {
            "name": "gcc-win-debug",
            "configurePreset": "gcc-win-debug"
        }
    ]
}
